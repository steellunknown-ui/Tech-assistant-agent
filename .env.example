# ==============================================================================
# LiveKit Cloud or Self-Hosted Server
# ==============================================================================
LIVEKIT_URL=wss://your-project-id.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# For Web Client Next.js frontend
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project-id.livekit.cloud

# ==============================================================================
# STT Provider (Deepgram Streaming)
# ==============================================================================
DEEPGRAM_API_KEY=your_deepgram_api_key

# ==============================================================================
# LLM Providers (Primary: Google Gemini Flash, Fallback: Groq)
# ==============================================================================
# Google Gemini API key
GOOGLE_API_KEY=your_google_gemini_api_key

# Groq API key for high-speed fallback
GROQ_API_KEY=your_groq_api_key

# ==============================================================================
# TTS Providers (Cartesia Sonic, Fish Audio, Deepgram Aura)
# ==============================================================================
# Cartesia AI (Primary high-speed ultra-realistic voice)
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=b4a7492e-52bc-4626-b097-876593589fbd
CARTESIA_MODEL=sonic-3

# Alternative: Direct Fish Audio API
FISH_API_KEY=your_fish_audio_api_key
FISH_AUDIO_VOICE_ID=

# Turn & Latency Options
LLM_PROVIDER=groq
MIN_ENDPOINTING_DELAY=0.3
MAX_ENDPOINTING_DELAY=1.5
INTERRUPTION_MODE=vad
PREEMPTIVE_GENERATION=true
PREEMPTIVE_TTS=true
